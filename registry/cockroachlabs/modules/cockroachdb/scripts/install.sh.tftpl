#!/usr/bin/env bash
set -euo pipefail

ARG_MODULE_DIR_NAME='${ARG_MODULE_DIR_NAME}'
CRDB_VERSION='${ARG_CRDB_VERSION}'
STORE_PATH=$(echo -n '${ARG_STORE_PATH}' | base64 -d)
SQL_PORT='${ARG_SQL_PORT}'
HTTP_PORT='${ARG_HTTP_PORT}'
BINARY_URL=$(echo -n '${ARG_BINARY_URL}' | base64 -d)
# Official SHA-256 of the module's default version, per arch. Empty for any
# other version, which is then verified against the mirror's .sha256sum.
PINNED_SHA256_AMD64='${ARG_PINNED_SHA256_AMD64}'
PINNED_SHA256_ARM64='${ARG_PINNED_SHA256_ARM64}'
# Overridable for tests.
: "$${READY_TIMEOUT:=60}"
: "$${NET_SYS_DIR:=/sys/class/net}"
: "$${LIBC_PROBE_DIR:=/lib}"
# Set by the Coder agent; on PATH for every workspace session.
: "$${CODER_SCRIPT_BIN_DIR:=$HOME/.local/bin}"

MODULE_DIR="$HOME/$ARG_MODULE_DIR_NAME"
SCRIPTS_DIR="$MODULE_DIR/scripts"
STATE_DIR="$MODULE_DIR/state"
VERSIONS_DIR="$MODULE_DIR/bin"
BIN_DIR="$CODER_SCRIPT_BIN_DIR"
PID_FILE="$STATE_DIR/crdb.pid"
LOG_FILE="$MODULE_DIR/logs/cockroach.log"
# start.sh starts CockroachDB only when this exists. coder-utils runs the start
# script after the install script even if the install script failed.
INSTALLED_MARKER="$STATE_DIR/installed"

rm -f "$INSTALLED_MARKER"

[[ -n "$STORE_PATH" ]] || STORE_PATH="$MODULE_DIR/data"
if [[ "$STORE_PATH" != /* ]]; then
  echo "store_path must be an absolute path, got '$STORE_PATH'." >&2
  exit 1
fi

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Unsupported OS: $(uname -s). This module supports Linux workspace agents only." >&2
  exit 1
fi

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *)
    echo "Unsupported arch: $(uname -m). See https://www.cockroachlabs.com/docs/stable/install-cockroachdb for manual install." >&2
    exit 1
    ;;
esac

# curl is needed for the readiness check even when cockroach is preinstalled.
command -v curl > /dev/null || {
  echo "Missing required tool: curl. Install it in the workspace image (for example: apt-get install -y curl)." >&2
  exit 1
}

mkdir -p "$SCRIPTS_DIR" "$STATE_DIR" "$MODULE_DIR/logs" "$VERSIONS_DIR" "$BIN_DIR"

write_script() {
  cat > "$SCRIPTS_DIR/$1.tmp"
  chmod +x "$SCRIPTS_DIR/$1.tmp"
  mv -f "$SCRIPTS_DIR/$1.tmp" "$SCRIPTS_DIR/$1"
}

write_script crdb-common.sh << 'EOF'
# shellcheck shell=bash
# shellcheck disable=SC2034 # CRDB_STORE* are results for the sourcing script.
# Shared by install.sh, crdb-start, and crdb-reset, which set CRDB_ROOT (the
# module directory) before sourcing this file.
: "$${CRDB_ROOT:?CRDB_ROOT must be set}"

# True only if the PID is alive and its command line is a CockroachDB server,
# so a PID reused by an unrelated process is never mistaken for the database.
crdb_running() {
  local cmd
  kill -0 "$1" 2> /dev/null || return 1
  if [[ -r "/proc/$1/cmdline" ]]; then
    cmd="$(tr '\0' ' ' < "/proc/$1/cmdline" 2> /dev/null || true)"
  else
    cmd="$(ps -p "$1" -o args= 2> /dev/null || true)"
  fi
  [[ "$cmd" == *start-single-node* ]]
}

# crdb_check_store PATH succeeds if PATH is safe to use as the store, and to
# empty with crdb-reset. It sets CRDB_STORE (PATH without a trailing /) and
# CRDB_STORE_REAL (symlinks resolved; for a directory that does not exist yet,
# its nearest existing ancestor is resolved and the rest appended). Otherwise it
# sets CRDB_STORE_REASON and fails. It refuses /, $HOME and its ancestors, and
# anything overlapping CRDB_ROOT except CRDB_ROOT/data and paths under it.
crdb_check_store() {
  local store="$1" p h r probe rest real
  local -a candidates homes roots
  CRDB_STORE=""
  CRDB_STORE_REAL=""
  CRDB_STORE_REASON=""
  if [[ "$store" != /* ]]; then
    CRDB_STORE_REASON="the store path is not absolute."
    return 1
  fi
  case "$store" in
    *//* | */./* | */../* | */. | */..)
      CRDB_STORE_REASON="the store path contains '.', '..', or '//' segments."
      return 1
      ;;
  esac
  store="$${store%/}"
  if [[ -z "$store" ]]; then
    CRDB_STORE_REASON="that is the filesystem root."
    return 1
  fi

  # Check the path as written and its symlink-resolved form. A directory that
  # does not exist yet will be created below its nearest existing ancestor, so
  # resolve that ancestor: a symlinked parent must not hide the real location.
  probe="$store"
  rest=""
  while [[ ! -d "$probe" ]]; do
    rest="/$${probe##*/}$rest"
    probe="$${probe%/*}"
    [[ -n "$probe" ]] || probe="/"
  done
  real="$(cd "$probe" && pwd -P)"
  [[ "$real" != "/" ]] || real=""
  CRDB_STORE_REAL="$real$rest"
  candidates=("$store")
  if [[ "$CRDB_STORE_REAL" != "$store" ]]; then candidates+=("$CRDB_STORE_REAL"); fi
  homes=("$${HOME%/}")
  if [[ -d "$HOME" ]]; then homes+=("$(cd "$HOME" && pwd -P)"); fi
  roots=("$${CRDB_ROOT%/}")
  if [[ -d "$CRDB_ROOT" ]]; then roots+=("$(cd "$CRDB_ROOT" && pwd -P)"); fi

  for p in "$${candidates[@]}"; do
    if [[ -z "$p" || "$p" == "/" ]]; then
      CRDB_STORE_REASON="that is the filesystem root."
      return 1
    fi
    for h in "$${homes[@]}"; do
      if [[ "$p" == "$h" ]]; then
        CRDB_STORE_REASON="that is your home directory."
        return 1
      fi
      if [[ "$h" == "$p"/* ]]; then
        CRDB_STORE_REASON="it contains your home directory."
        return 1
      fi
    done
    for r in "$${roots[@]}"; do
      if [[ "$p" == "$r" || "$r" == "$p"/* ]] \
        || [[ "$p" == "$r"/* && "$p" != "$r/data" && "$p" != "$r/data/"* ]]; then
        CRDB_STORE_REASON="it overlaps the module's own directory ($CRDB_ROOT). Only $CRDB_ROOT/data may hold the store."
        return 1
      fi
    done
  done
  CRDB_STORE="$store"
}
EOF

# shellcheck disable=SC2034 # Read by crdb-common.sh.
CRDB_ROOT="$MODULE_DIR"
# shellcheck source=/dev/null
source "$SCRIPTS_DIR/crdb-common.sh"
if ! crdb_check_store "$STORE_PATH"; then
  echo "Refusing to use '$STORE_PATH' as the CockroachDB store: $CRDB_STORE_REASON" >&2
  exit 1
fi

# Insecure mode is safe only if the 127.0.0.1 loopback is private to this
# workspace. Host container interfaces (docker0, veth*, CNI) suggest host
# networking on a shared machine. A VM workspace running Docker also matches,
# so only warn.
if compgen -G "$NET_SYS_DIR/docker0" > /dev/null \
  || compgen -G "$NET_SYS_DIR/veth*" > /dev/null \
  || compgen -G "$NET_SYS_DIR/cni*" > /dev/null \
  || compgen -G "$NET_SYS_DIR/cali*" > /dev/null; then
  echo "WARNING: this workspace may share its host's network (container interfaces found in $NET_SYS_DIR)." >&2
  echo "CockroachDB runs without a password. On a machine shared by several developers, others may reach 127.0.0.1:$SQL_PORT." >&2
  echo "Do not use this module with host-networked templates on shared machines." >&2
fi

# A cockroach baked into the image wins (restricted networks). The module's own
# link in BIN_DIR is skipped, since it points at an earlier download.
find_preinstalled() {
  local dir bin_real dir_real
  local -a dirs
  bin_real="$(cd "$BIN_DIR" && pwd -P)"
  IFS=: read -r -a dirs <<< "$PATH"
  for dir in $${dirs[@]+"$${dirs[@]}"}; do
    [[ -n "$dir" && -d "$dir" ]] || continue
    dir_real="$(cd "$dir" && pwd -P)" || continue
    [[ "$dir_real" != "$bin_real" ]] || continue
    if [[ -f "$dir/cockroach" && -x "$dir/cockroach" ]]; then
      printf '%s\n' "$dir/cockroach"
      return 0
    fi
  done
  return 0
}

PREINSTALLED="$(find_preinstalled)"
if [[ -n "$PREINSTALLED" ]]; then
  BINARY_PATH="$PREINSTALLED"
  echo "Using preinstalled cockroach at $BINARY_PATH (crdb_version is ignored)."
  "$BINARY_PATH" version 2> /dev/null | head -n 1 || true
else
  echo "Using CockroachDB $CRDB_VERSION on linux-$ARCH"
  VERSION_DIR="$VERSIONS_DIR/$CRDB_VERSION"
  BINARY_PATH="$VERSION_DIR/cockroach"

  if [[ ! -x "$BINARY_PATH" ]]; then
    for tool in tar sha256sum; do
      command -v "$tool" > /dev/null || {
        # sha256sum ships in the coreutils package.
        pkg="$tool"
        [[ "$tool" != sha256sum ]] || pkg=coreutils
        echo "Missing required tool: $tool. Install it in the workspace image (for example: apt-get install -y $pkg), or bake cockroach into the image." >&2
        exit 1
      }
    done

    # CockroachDB's Linux binaries are linked against glibc. Detect glibc
    # first: a Debian or Ubuntu image with the musl package installed has
    # ld-musl-* files but is still glibc.
    LDD_OUT="$(ldd --version 2>&1 || true)"
    IS_GLIBC=0
    if getconf GNU_LIBC_VERSION > /dev/null 2>&1 \
      || [[ "$LDD_OUT" == *GLIBC* || "$LDD_OUT" == *"GNU libc"* ]]; then
      IS_GLIBC=1
    fi
    if [[ "$IS_GLIBC" -eq 0 ]] \
      && { compgen -G "$LIBC_PROBE_DIR/ld-musl-*" > /dev/null || [[ "$LDD_OUT" == *musl* ]]; }; then
      echo "This system uses musl libc (for example Alpine), and CockroachDB's Linux binaries need glibc. Use a glibc-based image such as Debian, Ubuntu, or UBI, or bake a compatible cockroach into the image." >&2
      exit 1
    fi

    PREFIX="cockroach-$${CRDB_VERSION}.linux-$${ARCH}"
    TARBALL="$${PREFIX}.tgz"
    URL="$${BINARY_URL%/}/$${TARBALL}"
    echo "Downloading $URL..."
    WORK="$(mktemp -d)" || {
      echo "Could not create a temporary directory. Check free disk space in $${TMPDIR:-/tmp}, then re-run." >&2
      exit 1
    }
    trap 'rm -rf "$WORK"' EXIT

    curl -fsSL -o "$WORK/$TARBALL" "$URL" || {
      rc=$?
      if [[ "$rc" -eq 23 ]]; then
        echo "Could not write the download of $URL to $WORK. Check free disk space, then re-run." >&2
      elif [[ "$rc" -eq 22 ]]; then
        echo "Could not download $URL. The server returned an HTTP error, so this version may not exist at binary_url. Check crdb_version and the mirror." >&2
      else
        echo "Could not download $URL. On restricted networks, set binary_url to an internal mirror or bake cockroach into the image." >&2
      fi
      exit 1
    }
    case "$ARCH" in
      amd64) PINNED="$PINNED_SHA256_AMD64" ;;
      *) PINNED="$PINNED_SHA256_ARM64" ;;
    esac
    if [[ -n "$PINNED" ]]; then
      # The default version is checked against a hash pinned in the module, so
      # a mirror cannot swap the tarball and its checksum together.
      ACTUAL="$(sha256sum "$WORK/$TARBALL")" || {
        echo "Could not compute the SHA-256 of $WORK/$TARBALL." >&2
        exit 1
      }
      if [[ "$${ACTUAL%% *}" != "$PINNED" ]]; then
        echo "Checksum mismatch for $URL: the file does not match the checksum pinned in this module. The mirror may be serving a modified or different file." >&2
        exit 1
      fi
    else
      curl -fsSL -o "$WORK/$TARBALL.sha256sum" "$URL.sha256sum" || {
        echo "Could not download $URL.sha256sum. A binary_url mirror must also serve the .sha256sum file next to the tarball." >&2
        exit 1
      }
      (cd "$WORK" && sha256sum -c "$TARBALL.sha256sum") || {
        echo "Checksum verification failed for $URL. The download may be corrupt, or the mirror may be out of date." >&2
        exit 1
      }
    fi

    # Extract into the temp dir, then copy and rename within the final
    # directory so an interrupted run never leaves a partial install. The
    # binary moves last: its presence means the install is complete.
    mkdir -p "$VERSION_DIR"
    # The if/return chain is explicit because set -e is off inside "if !".
    install_files() {
      local src="$WORK/x/$PREFIX"
      mkdir -p "$WORK/x" || return 1
      tar -xzf "$WORK/$TARBALL" -C "$WORK/x" || return 1
      [[ -f "$src/cockroach" ]] || return 1
      if [[ -d "$src/lib" ]]; then
        rm -rf "$VERSION_DIR/lib.partial"
        cp -R "$src/lib" "$VERSION_DIR/lib.partial" || return 1
        rm -rf "$${VERSION_DIR:?}/lib"
        mv "$VERSION_DIR/lib.partial" "$VERSION_DIR/lib" || return 1
      fi
      cp "$src/cockroach" "$BINARY_PATH.partial" || return 1
      chmod +x "$BINARY_PATH.partial" || return 1
      mv -f "$BINARY_PATH.partial" "$BINARY_PATH" || return 1
    }
    if ! install_files; then
      rm -rf "$BINARY_PATH.partial" "$VERSION_DIR/lib.partial"
      echo "Failed to extract cockroach to $BINARY_PATH. Check free disk space and permissions, then re-run." >&2
      exit 1
    fi
    rm -rf "$WORK"
    trap - EXIT
    DOWNLOADED=1
  fi

  # Remember the version that was active before this one, so a rollback after a
  # failed version change needs no download. Recorded only once the binary is
  # in place.
  ACTIVE_FILE="$STATE_DIR/active_version"
  PREVIOUS_FILE="$STATE_DIR/previous_version"
  LAST_ACTIVE="$(cat "$ACTIVE_FILE" 2> /dev/null || true)"
  if [[ -n "$LAST_ACTIVE" && "$LAST_ACTIVE" != "$CRDB_VERSION" ]]; then
    printf '%s\n' "$LAST_ACTIVE" > "$PREVIOUS_FILE"
  fi
  printf '%s\n' "$CRDB_VERSION" > "$ACTIVE_FILE"

  # After a download, remove every version except the active one and the
  # previously active one. Skip it when a running CockroachDB (per the PID
  # file) may still be using an old version's files.
  if [[ "$${DOWNLOADED:-0}" -eq 1 ]]; then
    KEEP_PREVIOUS="$(cat "$PREVIOUS_FILE" 2> /dev/null || true)"
    RUNNING_PID="$(cat "$PID_FILE" 2> /dev/null || true)"
    if [[ -z "$RUNNING_PID" ]] || ! crdb_running "$RUNNING_PID"; then
      for old in "$VERSIONS_DIR"/v*; do
        [[ -d "$old" && "$old" != "$VERSION_DIR" && "$old" != "$VERSIONS_DIR/$KEEP_PREVIOUS" ]] || continue
        rm -rf "$old"
      done
    fi
  fi

  ln -sf "$BINARY_PATH" "$BIN_DIR/cockroach"
fi

# The helpers are static scripts that read their settings from this file, so
# no value is ever spliced into script text. %q quotes each value for bash.
{
  printf '%s=%q\n' PID_FILE "$PID_FILE"
  printf '%s=%q\n' STORE_PATH "$STORE_PATH"
  printf '%s=%q\n' BINARY_PATH "$BINARY_PATH"
  printf '%s=%q\n' LOG_FILE "$LOG_FILE"
  printf '%s=%q\n' SQL_PORT "$SQL_PORT"
  printf '%s=%q\n' HTTP_PORT "$HTTP_PORT"
  printf '%s=%q\n' READY_TIMEOUT_DEFAULT "$READY_TIMEOUT"
} > "$STATE_DIR/config.env.tmp"
mv -f "$STATE_DIR/config.env.tmp" "$STATE_DIR/config.env"

# Each helper starts with its CRDB_ROOT, quoted with %q, so it can find
# config.env and crdb-common.sh when run through its link in BIN_DIR.
helper_prelude() {
  printf '#!/usr/bin/env bash\nset -euo pipefail\n'
  printf 'CRDB_ROOT=%q\n' "$MODULE_DIR"
}

{
  helper_prelude
  cat << 'EOF'
CONFIG_FILE="$CRDB_ROOT/state/config.env"
if [[ ! -f "$CONFIG_FILE" || ! -f "$CRDB_ROOT/scripts/crdb-common.sh" ]]; then
  echo "CockroachDB module config not found at $CONFIG_FILE. Restart the workspace to reinstall." >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$CRDB_ROOT/scripts/crdb-common.sh"
# shellcheck source=/dev/null
source "$CONFIG_FILE"
: "$${PID_FILE:?}" "$${STORE_PATH:?}" "$${BINARY_PATH:?}" "$${LOG_FILE:?}"
: "$${SQL_PORT:?}" "$${HTTP_PORT:?}" "$${READY_TIMEOUT_DEFAULT:?}"

if ! crdb_check_store "$STORE_PATH"; then
  echo "Refusing to use '$STORE_PATH' as the CockroachDB store: $CRDB_STORE_REASON" >&2
  exit 1
fi
if [[ -f "$PID_FILE" ]] && crdb_running "$(cat "$PID_FILE")"; then
  echo "CockroachDB already running (PID $(cat "$PID_FILE"))."
  exit 0
fi
rm -f "$PID_FILE"
mkdir -p "$STORE_PATH" "$(dirname "$LOG_FILE")"
# The log is append-only, so remember where this run's output begins.
LOG_START="$({ wc -c < "$LOG_FILE"; } 2> /dev/null || echo 0)"
LOG_START=$((LOG_START + 0))
echo "Starting CockroachDB..."
# No diagnostics reporting: workspaces may sit inside a no-egress perimeter.
COCKROACH_SKIP_ENABLING_DIAGNOSTIC_REPORTING=true nohup "$BINARY_PATH" start-single-node \
  --insecure \
  --store="$STORE_PATH" \
  --listen-addr="127.0.0.1:$SQL_PORT" \
  --http-addr="127.0.0.1:$HTTP_PORT" \
  --pid-file="$PID_FILE" \
  >> "$LOG_FILE" 2>&1 &
CHILD=$!
TIMEOUT="$${READY_TIMEOUT:-$READY_TIMEOUT_DEFAULT}"
# Bounded by elapsed time, not iterations: each health check can take up to 2s.
SECONDS=0
while ((SECONDS < TIMEOUT)); do
  # Sleep first so a child that dies at startup is seen before health is asked.
  sleep 1
  if ! kill -0 "$CHILD" 2> /dev/null; then
    echo "CockroachDB exited before becoming ready. Last log lines:" >&2
    tail -n 20 "$LOG_FILE" >&2 || true
    if tail -c "+$((LOG_START + 1))" "$LOG_FILE" 2> /dev/null | grep -qi 'address already in use'; then
      echo "Another process is using port $SQL_PORT or $HTTP_PORT. Set sql_port / http_port in the module block." >&2
    fi
    echo "Full log: $LOG_FILE" >&2
    exit 1
  fi
  # CockroachDB writes --pid-file only after it starts listening. Requiring
  # our child's PID there means a health answer comes from our process, not
  # from another one holding the port.
  if [[ -f "$PID_FILE" && "$(cat "$PID_FILE" 2> /dev/null || true)" == "$CHILD" ]] \
    && curl -fsS --max-time 2 "http://127.0.0.1:$HTTP_PORT/health?ready=1" > /dev/null 2>&1; then
    echo "CockroachDB ready: SQL 127.0.0.1:$SQL_PORT | Console http://127.0.0.1:$HTTP_PORT"
    exit 0
  fi
done
echo "CockroachDB not ready after $${SECONDS}s. Last log lines:" >&2
tail -n 20 "$LOG_FILE" >&2 || true
echo "Full log: $LOG_FILE" >&2
exit 1
EOF
} | write_script crdb-start

{
  helper_prelude
  cat << 'EOF'
CONFIG_FILE="$CRDB_ROOT/state/config.env"
if [[ ! -f "$CONFIG_FILE" || ! -f "$CRDB_ROOT/scripts/crdb-common.sh" ]]; then
  echo "CockroachDB module config not found at $CONFIG_FILE. Restart the workspace to reinstall." >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$CRDB_ROOT/scripts/crdb-common.sh"
# shellcheck source=/dev/null
source "$CONFIG_FILE"
: "$${PID_FILE:?}" "$${STORE_PATH:?}" "$${HTTP_PORT:?}"

refuse() {
  echo "Refusing to wipe '$STORE_PATH': $1" >&2
  exit 1
}

crdb_check_store "$STORE_PATH" || refuse "$CRDB_STORE_REASON"
STORE="$CRDB_STORE"
# find does not follow a symlink given as its starting point, so every find
# below uses the resolved path.
STORE_REAL="$CRDB_STORE_REAL"

if [[ -e "$STORE" && ! -d "$STORE" ]]; then
  refuse "it is not a directory."
fi
# A top-level lost+found (always present on a dedicated ext4 volume) is ignored.
if [[ -d "$STORE_REAL" && -n "$(find "$STORE_REAL" -mindepth 1 -maxdepth 1 ! -name 'lost+found' -print -quit)" ]]; then
  HAS_MANIFEST="$(find "$STORE_REAL" -maxdepth 1 -name 'MANIFEST-*' -print -quit)"
  HAS_POINTER="$(find "$STORE_REAL" -maxdepth 1 \( -name CURRENT -o -name 'marker.manifest.*' \) -print -quit)"
  HAS_VERSION="$(find "$STORE_REAL" -maxdepth 1 \( -name COCKROACHDB_VERSION -o -name STORAGE_MIN_VERSION \) -print -quit)"
  # A failed first start leaves only cockroach-temp*, temp-dirs-record.txt, and
  # logs. A logs directory counts only with evidence it came from CockroachDB:
  # logs/cockroach.log, or a temp entry beside it.
  HAS_TEMP="$(find "$STORE_REAL" -mindepth 1 -maxdepth 1 \( -name 'cockroach-temp*' -o -name temp-dirs-record.txt \) -print -quit)"
  if [[ -f "$STORE_REAL/logs/cockroach.log" || -n "$HAS_TEMP" ]]; then
    HAS_OTHER="$(find "$STORE_REAL" -mindepth 1 -maxdepth 1 ! -name 'lost+found' ! -name logs ! -name 'cockroach-temp*' ! -name temp-dirs-record.txt -print -quit)"
  else
    HAS_OTHER="$(find "$STORE_REAL" -mindepth 1 -maxdepth 1 ! -name 'lost+found' ! -name 'cockroach-temp*' ! -name temp-dirs-record.txt -print -quit)"
  fi
  if [[ (-z "$HAS_MANIFEST" || -z "$HAS_POINTER") && -z "$HAS_VERSION" && -n "$HAS_OTHER" ]]; then
    refuse "the directory is not empty and does not look like a CockroachDB store (no MANIFEST-* file with CURRENT or marker.manifest.*). Use a dedicated directory for store_path."
  fi
fi

STOPPED=0
if [[ -f "$PID_FILE" ]] && crdb_running "$(cat "$PID_FILE")"; then
  STOPPED=1
  PID="$(cat "$PID_FILE")"
  echo "Stopping CockroachDB (PID $PID)..."
  kill "$PID"
  # crdb_running, not kill -0: a zombie that PID 1 never reaps still answers
  # kill -0, but its command line is empty.
  for _ in $(seq 1 30); do
    crdb_running "$PID" || break
    sleep 1
  done
  if crdb_running "$PID"; then
    echo "CockroachDB did not stop within 30s; aborting reset." >&2
    exit 1
  fi
fi
# Without a PID file we cannot stop the database, so never wipe a live one.
if [[ "$STOPPED" -eq 0 ]] && curl -fsS --max-time 2 "http://127.0.0.1:$HTTP_PORT/health" > /dev/null 2>&1; then
  echo "CockroachDB is answering on port $HTTP_PORT, but not as the process recorded in $PID_FILE; stop it first." >&2
  exit 1
fi
rm -f "$PID_FILE"
# Empty the directory but keep it (and lost+found), so a mount point still works.
if [[ -d "$STORE_REAL" ]]; then
  find "$STORE_REAL" -mindepth 1 -maxdepth 1 ! -name 'lost+found' -exec rm -rf {} +
fi
echo "Store at $STORE_PATH wiped. Starting a fresh cluster..."
exec "$CRDB_ROOT/scripts/crdb-start"
EOF
} | write_script crdb-reset

for helper in crdb-start crdb-reset; do
  ln -sf "$SCRIPTS_DIR/$helper" "$BIN_DIR/$helper"
done

touch "$INSTALLED_MARKER"
